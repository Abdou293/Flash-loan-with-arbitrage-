# Copy this file to ".env" and fill in your own values.
# NEVER commit ".env". All values below are PLACEHOLDERS.

# RPC endpoints (free tiers). Put your real URL only in .env, never here.
ARBITRUM_RPC_URL=https://YOUR-ARBITRUM-RPC-URL-HERE
ARBITRUM_SEPOLIA_RPC_URL=https://YOUR-ARBITRUM-SEPOLIA-RPC-URL-HERE

# Burner wallet ONLY (a new wallet with testnet funds, never your main wallet).
# Leave empty while in dry-run mode.
PRIVATE_KEY=

# Safety: dry-run is the default and never sends real transactions.
DRY_RUN=true

# Free-RPC friendliness
POLL_INTERVAL_MS=15000

# Public (non-secret) addresses, only needed once the contract is deployed (Phase 5)
FLASH_ARB_ADDRESS=
OWNER_ADDRESS=
